{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 26, "patch": 5 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "UNITY_ID": "jdoe12",
        "DC_CLOCK_PER": "10.0"
      }
    },
    { "name": "run",  "inherits": "base", "cacheVariables": { "TEST": "-1" } },
    { "name": "test0", "inherits": "base", "cacheVariables": { "TEST": "0"  } },
    { "name": "test1", "inherits": "base", "cacheVariables": { "TEST": "1"  } },
    { "name": "test2", "inherits": "base", "cacheVariables": { "TEST": "2"  } },
    { "name": "test3", "inherits": "base", "cacheVariables": { "TEST": "3"  } }
  ],
  "buildPresets": [
    { "name": "run",   "configurePreset": "run"   },
    { "name": "test0", "configurePreset": "test0" },
    { "name": "test1", "configurePreset": "test1" },
    { "name": "test2", "configurePreset": "test2" },
    { "name": "test3", "configurePreset": "test3" }
  ]
}

